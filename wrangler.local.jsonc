{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "foxtutor-learn-local",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-05",
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "foxtutor-learn-local",
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RESOURCES_BUCKET",
      "bucket_name": "foxtutor-learn-resources-local",
      "preview_bucket_name": "foxtutor-learn-resources-local"
    }
  ],
  "vars": {
    "ENVIRONMENT": "local",
    "PUBLIC_ORIGIN": "http://localhost:8787/learn",
    "CALENDAR_FEED_ENCRYPTION_KEY": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
    "MAIL_API_URL": "https://mail.foxtutor.org",
    "MAIL_API_FROM": "hello@foxtutor.org",
    "MAIL_API_BILLING_FROM": "billing@foxtutor.org",
    "MAIL_API_REPLY_TO": "james@foxtutor.org"
  }
}
