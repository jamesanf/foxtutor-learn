ENVIRONMENT=local
PUBLIC_ORIGIN=http://localhost:8787/learn
MAIL_API_URL=https://mail.foxtutor.org
MAIL_API_FROM=hello@foxtutor.org
# MAIL_API_TOKEN is a secret; provide it only through Wrangler secrets in production.
# MAIL_API_ACCESS_CLIENT_ID and MAIL_API_ACCESS_CLIENT_SECRET are optional
# Cloudflare Access service-auth secrets for the Fox Mail internal API.
# FreeAgent credentials and company/provider identifiers remain omitted until
# acceptance. Supply secrets only through Wrangler secrets or production
# configuration, never in this file. Sandbox and Production use separate
# credentials, token encryption keys, company pins and OAuth redirect values.
# The category is selected from the authenticated company's read-only
# categories endpoint in the admin UI; never paste a raw category URL here.
# Legacy billing-operation default only; it does not select which FreeAgent
# connection exists. The admin UI always addresses Sandbox and Production
# explicitly.
# FREEAGENT_ENVIRONMENT=sandbox
# Sandbox-only legacy compatibility names:
# FREEAGENT_CLIENT_ID=
# FREEAGENT_CLIENT_SECRET=
# FREEAGENT_TOKEN_ENCRYPTION_KEY=
# FREEAGENT_OAUTH_REDIRECT_URI=https://foxtutor.org/learn/admin/accounting/oauth/callback
# FREEAGENT_COMPANY_SUBDOMAIN=
# Preferred Sandbox names:
# FREEAGENT_SANDBOX_CLIENT_ID=
# FREEAGENT_SANDBOX_CLIENT_SECRET=
# FREEAGENT_SANDBOX_TOKEN_ENCRYPTION_KEY=
# FREEAGENT_SANDBOX_OAUTH_REDIRECT_URI=https://foxtutor.org/learn/admin/accounting/oauth/callback
# FREEAGENT_SANDBOX_COMPANY_SUBDOMAIN=
# Production names:
# FREEAGENT_PRODUCTION_CLIENT_ID=
# FREEAGENT_PRODUCTION_CLIENT_SECRET=
# FREEAGENT_PRODUCTION_TOKEN_ENCRYPTION_KEY=
# FREEAGENT_PRODUCTION_OAUTH_REDIRECT_URI=https://foxtutor.org/learn/admin/accounting/oauth/callback
# FREEAGENT_PRODUCTION_COMPANY_SUBDOMAIN=
# FREEAGENT_INVOICE_AMOUNT=55.00
# FREEAGENT_INVOICE_ITEM_TYPE=Hours
# Category selection is persisted through /learn/admin/accounting/settings.
# FREEAGENT_INVOICE_PAYMENT_TERMS_DAYS=0
# FREEAGENT_INVOICE_CURRENCY=GBP
# FreeAgent invoice items must explicitly send sales_tax_rate=0 because the
# business is not VAT registered and must not inherit contact/company defaults.
# FREEAGENT_INVOICE_SALES_TAX_RATE=0
